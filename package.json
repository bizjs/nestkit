{
  "name": "@bizjs/nestkit",
  "version": "1.1.0",
  "description": "A toolkit package for nest.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "pub": "npm run build && npm publish",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "nestjs",
    "nest",
    "toolkit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bizjs/nestkit.git"
  },
  "bugs": {
    "url": "https://github.com/bizjs/nestkit/issues"
  },
  "author": "hstarorg <hm910705@163.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.2",
    "@nestjs/core": "^12.0.2",
    "@types/cookie-parser": "1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/on-headers": "^1.0.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "1.4.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "rxjs": "^7.8.2",
    "supertest": "6.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "class-transformer": ">=0.5.1",
    "class-validator": ">=0.14.0",
    "rxjs": "^7.8.1"
  },
  "dependencies": {
    "cache-manager": "^6.4.3",
    "connect-redis": "^9.0.0",
    "cookie": "^1.1.1",
    "cookie-signature": "^1.2.2",
    "on-headers": "~1.1.0",
    "redis": "^5.12.1"
  },
  "packageManager": "pnpm@11.19.0",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./express-session": {
      "types": "./dist/express-session/index.d.ts",
      "import": "./dist/express-session/index.mjs",
      "require": "./dist/express-session/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  }
}
