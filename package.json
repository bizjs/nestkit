{
  "name": "@bizjs/nestkit",
  "version": "1.0.0",
  "description": "A toolkit package for nest.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "pub": "npm run build && npm publish",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:session": "node --import tsx --test --test-timeout=10000 --test-reporter=spec tests/express-session/*.spec.ts",
    "test:session:cov": "node --import tsx --test --test-timeout=10000 --experimental-test-coverage --test-coverage-include=\"src/express-session/**/*.ts\" tests/express-session/*.spec.ts"
  },
  "keywords": [
    "nestjs",
    "nest",
    "toolkit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bizjs/nestkit.git"
  },
  "bugs": {
    "url": "https://github.com/bizjs/nestkit/issues"
  },
  "author": "hstarorg <hm910705@163.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "@types/cookie-parser": "1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/on-headers": "^1.0.4",
    "@types/supertest": "^7.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "1.4.6",
    "dotenv": "^16.4.7",
    "express": "4.17.3",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "supertest": "6.3.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "rxjs": "^7.8.1"
  },
  "dependencies": {
    "cache-manager": "^6.3.1",
    "connect-redis": "^9.0.0",
    "cookie": "^1.0.2",
    "cookie-signature": "^1.2.2",
    "on-headers": "~1.1.0",
    "redis": "^5.12.1"
  },
  "packageManager": "pnpm@11.19.0"
}
